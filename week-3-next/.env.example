# Environment Variables for FlyRankAI Next.js App
# ─────────────────────────────────────────────
# Duplicate this file as .env.local and fill values.
# NEVER commit .env.local — it is in .gitignore.

# ── App metadata ──────────────────────────────
NEXT_PUBLIC_APP_NAME="FlyRankAI"
NEXT_PUBLIC_APP_VERSION="2.4.0"

# ── Health-check / public API used in the health route ──
# This is a demo, so we use the public JSONPlaceholder for the
# health-check page. Replace with your real API base URL.
NEXT_PUBLIC_HEALTH_API_URL="https://jsonplaceholder.typicode.com"

# ── FlyRankAI API (server-side only, never exposed to browser) ──
# FLYRANK_API_KEY=your_secret_key_here
# FLYRANK_API_BASE_URL=https://api.flyrank.ai/v1
